# Copy to /opt/xai-proxy/.env and chmod 600.
# On the Studio this lived at /Users/btahedl/xai-proxy/.env — copy the key, not the Mac path.
XAI_API_KEY=xai-replace-me
XAI_BASE_URL=https://api.x.ai
PROXY_HOST=127.0.0.1
PROXY_PORT=8787
TTS_DEFAULT_VOICE=ara
TTS_DEFAULT_LANGUAGE=en
TTS_OPTIMIZE_STREAMING_LATENCY=1
# 44100 = MPEG-1 Layer III. Do not use 24000 (MPEG-2) — CarPlay/Safari talk mode
# plays those clips as ~0.5s of silence.
TTS_SAMPLE_RATE=44100
TTS_BIT_RATE=128000
# Spoken-form numbers/dates/abbreviations. xAI default is false.
TTS_TEXT_NORMALIZATION=true
# Pin the current STT model. xAI default is grok-voice-transcribe-2.0.
STT_MODEL=grok-voice-transcribe-2.0
# Comma-separated STT bias terms (max 100, 50 chars each). Empty disables.
STT_KEYTERMS=Grok,Ara,Open WebUI,Hexxus
LOG_LEVEL=info
